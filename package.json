{
  "name": "Strand Lab",
  "description": "Strand Lab is a premium hair restoration studio focused on professional treatments for damaged, dry, porous, and chemically treated hair. The website combines a refined visual style with clear service presentation, treatment information, and consultation-focused user flow.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node prebuild.js && vite",
    "build": "node prebuild.js && vite build",
    "preview": "vite preview",
    "predeploy": "node prebuild.js && vite build --mode github",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.3",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "postcss-sort-media-queries": "^6.6.2",
    "prettier": "^3.9.5",
    "prettier-plugin-css-order": "^2.2.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "ttf2woff2": "^8.0.1",
    "vite": "^7.3.6",
    "vite-plugin-html-inject": "^1.1.2",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "dependencies": {
    "flatpickr": "^4.6.13",
    "gsap": "^3.15.0",
    "mapbox-gl": "^3.26.0",
    "plyr": "^3.8.4",
    "swiper": "^12.2.0"
  }
}
